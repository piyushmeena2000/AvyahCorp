{% doc %}
  @prompt
    Create a new benefit-strip section for the homepage.
    
    Show these benefits as horizontal icon + text items:
    - No Maida
    - No Palm Oil
    - High Protein
    - No Added Preservatives
    - 100% Vegetarian
    - Made with Whole Grains
    
    Design:
    - Clean white or light-cream background.
    - Each benefit has a simple relevant line icon inside a small circular or rounded badge, followed by bold black text.
    - Arrange benefits in one horizontal row on desktop.
    - Add a smooth, seamless infinite marquee animation that moves left continuously and loops without any jump or blank gap.
    - Duplicate the items internally as needed to make the loop seamless.
    - Pause the animation when the user hovers over the strip.
    - Respect reduced-motion preferences: disable animation for users who prefer reduced motion.
    - On mobile, keep the marquee horizontal; do not wrap the benefits into multiple lines.
    - Use the existing theme’s fonts, spacing, and red accent color. Keep the section polished and premium, matching the product-card design.
    
    Implementation:
    - Create this as a reusable Shopify Liquid section with editable benefit text and icons in the section schema.
    - Do not use external icon libraries or external assets unless already present in the theme.
    - Make the change in the actual theme files and show the changed filenames.
    - Preview it in the browser and provide a screenshot before claiming completion.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefit-strip-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    overflow: hidden;
    position: relative;
  }

  .ai-benefit-strip-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-benefit-strip-track-{{ ai_gen_id }} {
      animation: ai-benefit-strip-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    }

    .ai-benefit-strip-{{ ai_gen_id }}:hover .ai-benefit-strip-track-{{ ai_gen_id }} {
      animation-play-state: paused;
    }
  }

  @keyframes ai-benefit-strip-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-benefit-strip-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-benefit-strip-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: {{ block.settings.icon_border_radius }}px;
    background-color: {{ block.settings.icon_background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-benefit-strip-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-benefit-strip-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    font-family: var(--font-{{ block.settings.text_font }}-family);
  }

  @media screen and (max-width: 749px) {
    .ai-benefit-strip-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical_mobile }}px 0;
    }

    .ai-benefit-strip-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-benefit-strip-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size_mobile }}px * 0.5);
      height: calc({{ block.settings.icon_size_mobile }}px * 0.5);
    }

    .ai-benefit-strip-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-benefit-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefit-strip-track-{{ ai_gen_id }}">
    {% liquid
      assign benefits = ''
      assign benefits = benefits | append: block.settings.benefit_1_text | append: '|' | append: block.settings.benefit_1_icon
      assign benefits = benefits | append: ',' | append: block.settings.benefit_2_text | append: '|' | append: block.settings.benefit_2_icon
      assign benefits = benefits | append: ',' | append: block.settings.benefit_3_text | append: '|' | append: block.settings.benefit_3_icon
      assign benefits = benefits | append: ',' | append: block.settings.benefit_4_text | append: '|' | append: block.settings.benefit_4_icon
      assign benefits = benefits | append: ',' | append: block.settings.benefit_5_text | append: '|' | append: block.settings.benefit_5_icon
      assign benefits = benefits | append: ',' | append: block.settings.benefit_6_text | append: '|' | append: block.settings.benefit_6_icon
      assign benefit_items = benefits | split: ','
    %}

    {% for i in (1..2) %}
      {% for benefit in benefit_items %}
        {% assign benefit_parts = benefit | split: '|' %}
        {% assign benefit_text = benefit_parts[0] %}
        {% assign benefit_icon = benefit_parts[1] %}
        
        {% if benefit_text != blank %}
          <div class="ai-benefit-strip-item-{{ ai_gen_id }}">
            <div class="ai-benefit-strip-icon-wrapper-{{ ai_gen_id }}">
              {% if benefit_icon == 'check' %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {% elsif benefit_icon == 'leaf' %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                </svg>
              {% elsif benefit_icon == 'shield' %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              {% elsif benefit_icon == 'heart' %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              {% elsif benefit_icon == 'star' %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              {% elsif benefit_icon == 'wheat' %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <path d="M2 22 16 8"></path>
                  <path d="M3.5 12.5 6 10"></path>
                  <path d="M6.5 9.5 9 7"></path>
                  <path d="M9.5 6.5 12 4"></path>
                  <path d="M12.5 3.5 15 1"></path>
                  <path d="M16 8c0-2.21-1.79-4-4-4"></path>
                  <path d="M16 8c2.21 0 4-1.79 4-4"></path>
                  <path d="M16 12c0-2.21-1.79-4-4-4"></path>
                  <path d="M16 12c2.21 0 4-1.79 4-4"></path>
                  <path d="M16 16c0-2.21-1.79-4-4-4"></path>
                  <path d="M16 16c2.21 0 4-1.79 4-4"></path>
                  <path d="M16 20c0-2.21-1.79-4-4-4"></path>
                  <path d="M16 20c2.21 0 4-1.79 4-4"></path>
                </svg>
              {% else %}
                <svg class="ai-benefit-strip-icon-{{ ai_gen_id }}" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {% endif %}
            </div>
            <span class="ai-benefit-strip-text-{{ ai_gen_id }}">{{ benefit_text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>

