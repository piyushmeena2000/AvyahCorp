{% doc %}
  @prompt
    Create a premium Featured Collection section for a modern D2C snack brand.
    
    The design should feel comparable to SuperYou, Apple, Nothing, and other premium Shopify stores. Keep the layout clean, spacious, minimal, and conversion-focused.
    
    SECTION HEADER
    
    Small eyebrow:
    OUR COLLECTION
    
    Main heading:
    Find Your Perfect Snack
    
    Description:
    Choose from our range of healthy multigrain snack bars and combos.
    
    FILTER TABS
    
    Create three premium pill-style tabs centered below the heading:
    
    • Single
    • Sharebox
    • Combo
    
    The active tab should use the brand color (#D52528).
    
    Inactive tabs should have a white background with a subtle border.
    
    Switching tabs should smoothly display products from different collections.
    
    PRODUCT GRID
    
    Desktop:
    • 4 products per row
    
    Tablet:
    • 2 products per row
    
    Mobile:
    • Horizontal swipe carousel with snap scrolling
    
    PRODUCT CARDS
    
    Use the existing product card style from the theme.
    
    Keep:
    • Product image
    • Bestseller badge
    • Pack label
    • Product title
    • Variant information
    • Price
    • Discount badge
    • Add to Cart button
    • Wishlist icon
    • Quick View button
    
    SECTION DESIGN
    
    • White background
    • Large vertical spacing
    • Maximum content width
    • Rounded corners
    • Soft premium shadows
    • Equal-height cards
    • Consistent spacing
    • Subtle hover lift effect
    • Smooth transitions
    
    THEME SETTINGS
    
    Allow editing:
    • Heading
    • Description
    • Tab labels
    • Collection for each tab
    • Products per row
    • Show or hide tabs
    
    The final section should feel polished, premium, highly organized, and optimized for conversions while matching the existing design language of the website.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-featured-collection-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-collection-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-featured-collection-eyebrow-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 12px;
  }

  .ai-featured-collection-heading-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-featured-collection-description-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.description_color }};
    max-width: 600px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .ai-featured-collection-tabs-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .ai-featured-collection-tab-{{ ai_gen_id }} {
    padding: 12px 32px;
    border-radius: 100px;
    border: 1px solid {{ block.settings.tab_border_color }};
    background-color: {{ block.settings.tab_background }};
    color: {{ block.settings.tab_text_color }};
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-featured-collection-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_background }};
    border-color: {{ block.settings.tab_hover_border }};
  }

  .ai-featured-collection-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_background }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_background }};
  }

  .ai-featured-collection-grid-{{ ai_gen_id }} {
    display: none;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: 24px;
  }

  .ai-featured-collection-grid-{{ ai_gen_id }}.active {
    display: grid;
  }

  .ai-featured-collection-card-{{ ai_gen_id }} {
    background: #ffffff;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-featured-collection-card-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-featured-collection-card-image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection-card-badges-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
  }

  .ai-featured-collection-badge-{{ ai_gen_id }} {
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-featured-collection-badge-bestseller-{{ ai_gen_id }} {
    background-color: #FFD700;
    color: #000000;
  }

  .ai-featured-collection-badge-discount-{{ ai_gen_id }} {
    background-color: {{ block.settings.tab_active_background }};
    color: #ffffff;
  }

  .ai-featured-collection-badge-pack-{{ ai_gen_id }} {
    background-color: #000000;
    color: #ffffff;
  }

  .ai-featured-collection-card-content-{{ ai_gen_id }} {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection-card-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: #000000;
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .ai-featured-collection-card-variant-{{ ai_gen_id }} {
    font-size: 13px;
    color: #666666;
    margin-bottom: 12px;
  }

  .ai-featured-collection-card-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-featured-collection-price-current-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: #000000;
  }

  .ai-featured-collection-price-compare-{{ ai_gen_id }} {
    font-size: 16px;
    color: #999999;
    text-decoration: line-through;
  }

  .ai-featured-collection-card-actions-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .ai-featured-collection-btn-{{ ai_gen_id }} {
    flex: 1;
    padding: 14px 20px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    text-align: center;
    text-decoration: none;
    display: inline-block;
  }

  .ai-featured-collection-btn-primary-{{ ai_gen_id }} {
    background-color: #000000;
    color: #ffffff;
  }

  .ai-featured-collection-btn-primary-{{ ai_gen_id }}:hover {
    background-color: #333333;
  }

  .ai-featured-collection-btn-icon-{{ ai_gen_id }} {
    width: 48px;
    padding: 14px;
    background-color: #f5f5f5;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-featured-collection-btn-icon-{{ ai_gen_id }}:hover {
    background-color: #e0e0e0;
  }

  .ai-featured-collection-btn-icon-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-collection-heading-{{ ai_gen_id }} {
      font-size: 36px;
    }

    .ai-featured-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-heading-{{ ai_gen_id }} {
      font-size: 28px;
    }

    .ai-featured-collection-description-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-featured-collection-grid-{{ ai_gen_id }} {
      display: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      grid-template-columns: repeat(auto-fill, 280px);
      gap: 16px;
      padding-bottom: 16px;
    }

    .ai-featured-collection-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-featured-collection-grid-{{ ai_gen_id }}.active {
      display: flex;
    }

    .ai-featured-collection-card-{{ ai_gen_id }} {
      scroll-snap-align: start;
      flex-shrink: 0;
      width: 280px;
    }

    .ai-featured-collection-tab-{{ ai_gen_id }} {
      padding: 10px 24px;
      font-size: 13px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection-container-{{ ai_gen_id }}">
    <div class="ai-featured-collection-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-featured-collection-eyebrow-{{ ai_gen_id }}">
          {{ block.settings.eyebrow }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-featured-collection-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-featured-collection-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_tabs %}
      <div class="ai-featured-collection-tabs-{{ ai_gen_id }}">
        <button
          class="ai-featured-collection-tab-{{ ai_gen_id }} active"
          data-tab="tab1"
          aria-label="{{ block.settings.tab_1_label }}"
        >
          {{ block.settings.tab_1_label }}
        </button>
        <button
          class="ai-featured-collection-tab-{{ ai_gen_id }}"
          data-tab="tab2"
          aria-label="{{ block.settings.tab_2_label }}"
        >
          {{ block.settings.tab_2_label }}
        </button>
        <button
          class="ai-featured-collection-tab-{{ ai_gen_id }}"
          data-tab="tab3"
          aria-label="{{ block.settings.tab_3_label }}"
        >
          {{ block.settings.tab_3_label }}
        </button>
      </div>
    {% endif %}

    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}

      <div
        class="ai-featured-collection-grid-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
        data-content="tab{{ i }}"
      >
        {% if collection != blank and collection.products.size > 0 %}
          {% for product in collection.products limit: block.settings.products_limit %}
            <div class="ai-featured-collection-card-{{ ai_gen_id }}">
              <div class="ai-featured-collection-card-image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}

                <div class="ai-featured-collection-card-badges-{{ ai_gen_id }}">
                  {% if product.tags contains 'bestseller' %}
                    <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-bestseller-{{ ai_gen_id }}">
                      Bestseller
                    </span>
                  {% endif %}

                  {% if product.compare_at_price > product.price %}
                    {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                    <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-discount-{{ ai_gen_id }}">
                      {{ discount }}% OFF
                    </span>
                  {% endif %}

                  {% if product.tags contains 'pack' %}
                    <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-pack-{{ ai_gen_id }}">
                      Pack
                    </span>
                  {% endif %}
                </div>
              </div>

              <div class="ai-featured-collection-card-content-{{ ai_gen_id }}">
                <h3 class="ai-featured-collection-card-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </h3>

                {% if product.variants.size > 1 %}
                  <div class="ai-featured-collection-card-variant-{{ ai_gen_id }}">
                    {{ product.variants.first.title }}
                  </div>
                {% endif %}

                <div class="ai-featured-collection-card-price-{{ ai_gen_id }}">
                  <span class="ai-featured-collection-price-current-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-featured-collection-price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>

                <div class="ai-featured-collection-card-actions-{{ ai_gen_id }}">
                  <a
                    href="{{ product.url }}"
                    class="ai-featured-collection-btn-{{ ai_gen_id }} ai-featured-collection-btn-primary-{{ ai_gen_id }}"
                  >
                    Add to Cart
                  </a>
                  <button
                    class="ai-featured-collection-btn-icon-{{ ai_gen_id }}"
                    aria-label="Add to wishlist"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                      />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <div class="ai-featured-collection-card-{{ ai_gen_id }}">
              <div class="ai-featured-collection-card-image-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
              <div class="ai-featured-collection-card-content-{{ ai_gen_id }}">
                <h3 class="ai-featured-collection-card-title-{{ ai_gen_id }}">
                  Product Title
                </h3>
                <div class="ai-featured-collection-card-price-{{ ai_gen_id }}">
                  <span class="ai-featured-collection-price-current-{{ ai_gen_id }}">
                    ₹299
                  </span>
                </div>
                <div class="ai-featured-collection-card-actions-{{ ai_gen_id }}">
                  <button class="ai-featured-collection-btn-{{ ai_gen_id }} ai-featured-collection-btn-primary-{{ ai_gen_id }}">
                    Add to Cart
                  </button>
                  <button class="ai-featured-collection-btn-icon-{{ ai_gen_id }}" aria-label="Add to wishlist">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                      />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-featured-collection-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-featured-collection-grid-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetTab = tab.getAttribute('data-tab');

            this.tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');

            this.contents.forEach((content) => {
              if (content.getAttribute('data-content') === targetTab) {
                content.classList.add('active');
              } else {
                content.classList.remove('active');
              }
            });
          });
        });
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

