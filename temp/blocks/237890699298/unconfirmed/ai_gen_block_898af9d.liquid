<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-featured-collection-tab-{{ ai_gen_id }}');
        this.collections = this.querySelectorAll('.ai-featured-collection-products-{{ ai_gen_id }}');
        this.setupTabs();
      }

      setupTabs() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetTab = tab.getAttribute('data-tab');
            
            this.tabs.forEach(t => t.classList.remove('active'));
            this.collections.forEach(c => c.classList.remove('active'));
            
            tab.classList.add('active');
            const targetCollection = this.querySelector(`[data-collection="${targetTab}"]`);
            if (targetCollection) {
              targetCollection.classList.add('active');
            }
          });
        });
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

