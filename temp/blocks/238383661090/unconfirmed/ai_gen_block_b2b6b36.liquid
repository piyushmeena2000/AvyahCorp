{% doc %}
  @prompt
    Create a new Shopify OS 2.0 section called Featured Product Carousel. Use a Shopify Collection Picker so products are loaded dynamically. Do not hardcode products. Create a full-width responsive section with an editable heading at the top and a horizontal product carousel below it. Show 4 products on desktop, 2 on tablet, and 1.2 on mobile., Update the product card to include:
    
    Product Image
    Hover Image (second image)
    Product Title
    Star Rating
    Review Count
    Compare-at Price
    Sale Price
    Discount Percentage
    Add to Cart Button
    Sale Badge if product is on sale
    
    Everything should be dynamic using Shopify product data., Add Previous and Next navigation buttons.
    
    Requirements:
    
    Position them at the top-right.
    One click moves one product.
    Smooth animation.
    Responsive positioning.
    Make arrow background, icon color, size, border radius and hover colors editable in Shopify.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-featured-carousel-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-carousel-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    gap: 20px;
  }

  .ai-featured-carousel-heading-wrapper-{{ ai_gen_id }} {
    flex-grow: 1;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-featured-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-featured-carousel-nav-top-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.nav_button_gap }}px;
    flex-shrink: 0;
  }

  .ai-featured-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-featured-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .ai-featured-carousel-product-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - (3 * {{ block.settings.product_gap }}px)) / 4);
    min-width: 0;
  }

  .ai-featured-carousel-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .ai-featured-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-featured-carousel-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-featured-carousel-image-primary-{{ ai_gen_id }} {
    z-index: 2;
  }

  .ai-featured-carousel-image-secondary-{{ ai_gen_id }} {
    z-index: 1;
    opacity: 0;
  }

  .ai-featured-carousel-card-{{ ai_gen_id }}:hover .ai-featured-carousel-image-primary-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-featured-carousel-card-{{ ai_gen_id }}:hover .ai-featured-carousel-image-secondary-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-featured-carousel-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 700;
    z-index: 3;
    text-transform: uppercase;
  }

  .ai-featured-carousel-info-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-carousel-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .ai-featured-carousel-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .ai-featured-carousel-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-featured-carousel-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.star_color }};
  }

  .ai-featured-carousel-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-featured-carousel-review-count-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-featured-carousel-price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .ai-featured-carousel-price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.sale_price_color }};
  }

  .ai-featured-carousel-compare-price-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    text-decoration: line-through;
  }

  .ai-featured-carousel-discount-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 700;
    color: {{ block.settings.discount_text_color }};
    background-color: {{ block.settings.discount_background }};
    padding: 4px 8px;
    border-radius: 4px;
  }

  .ai-featured-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-align: center;
    transition: background-color 0.3s ease;
    font-weight: 600;
    margin-top: auto;
    border: none;
    cursor: pointer;
    width: 100%;
  }

  .ai-featured-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-featured-carousel-nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: {{ block.settings.nav_button_border_radius }}px;
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    flex-shrink: 0;
  }

  .ai-featured-carousel-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
    color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-featured-carousel-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-carousel-nav-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.5);
    height: calc({{ block.settings.nav_button_size }}px * 0.5);
  }

  .ai-featured-carousel-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-featured-carousel-empty-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 16px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-carousel-product-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-carousel-product-{{ ai_gen_id }} {
      flex: 0 0 calc(100% / 1.2 - {{ block.settings.product_gap }}px);
    }

    .ai-featured-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-featured-carousel-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-featured-carousel-heading-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-featured-carousel-nav-top-{{ ai_gen_id }} {
      align-self: flex-end;
    }

    .ai-featured-carousel-nav-button-{{ ai_gen_id }} {
      width: calc({{ block.settings.nav_button_size }}px * 0.85);
      height: calc({{ block.settings.nav_button_size }}px * 0.85);
    }
  }
{% endstyle %}

<featured-product-carousel-{{ ai_gen_id }}
  class="ai-featured-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-carousel-container-{{ ai_gen_id }}">
    <div class="ai-featured-carousel-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <div class="ai-featured-carousel-heading-wrapper-{{ ai_gen_id }}">
          <h2 class="ai-featured-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        </div>
      {% endif %}

      {% if block.settings.show_navigation and block.settings.collection != blank and block.settings.collection.products.size > 0 %}
        <div class="ai-featured-carousel-nav-top-{{ ai_gen_id }}">
          <button
            class="ai-featured-carousel-nav-button-{{ ai_gen_id }}"
            data-carousel-prev
            aria-label="Previous product"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            class="ai-featured-carousel-nav-button-{{ ai_gen_id }}"
            data-carousel-next
            aria-label="Next product"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-featured-carousel-wrapper-{{ ai_gen_id }}">
        <div class="ai-featured-carousel-track-{{ ai_gen_id }}" data-carousel-track>
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            {% liquid
              assign on_sale = false
              if product.compare_at_price > product.price
                assign on_sale = true
              endif

              assign discount_percentage = 0
              if on_sale
                assign price_diff = product.compare_at_price | minus: product.price
                assign discount_percentage = price_diff | times: 100.0 | divided_by: product.compare_at_price | round
              endif

              assign second_image = product.images[1]
            %}

            <div class="ai-featured-carousel-product-{{ ai_gen_id }}">
              <product-card-{{ ai_gen_id }} class="ai-featured-carousel-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
                {% if on_sale and block.settings.show_sale_badge %}
                  <div class="ai-featured-carousel-badge-{{ ai_gen_id }}">
                    {{ block.settings.sale_badge_text }}
                  </div>
                {% endif %}

                <a href="{{ product.url }}" class="ai-featured-carousel-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-featured-carousel-image-{{ ai_gen_id }} ai-featured-carousel-image-primary-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                    {% if second_image and block.settings.show_hover_image %}
                      <img
                        src="{{ second_image | image_url: width: 600 }}"
                        alt="{{ second_image.alt | escape }}"
                        class="ai-featured-carousel-image-{{ ai_gen_id }} ai-featured-carousel-image-secondary-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% endif %}
                  {% else %}
                    <div class="ai-featured-carousel-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </a>

                <div class="ai-featured-carousel-info-{{ ai_gen_id }}">
                  <h3 class="ai-featured-carousel-title-{{ ai_gen_id }}">
                    <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                      {{ product.title }}
                    </a>
                  </h3>

                  {% if block.settings.show_rating %}
                    <div class="ai-featured-carousel-rating-{{ ai_gen_id }}">
                      <div class="ai-featured-carousel-stars-{{ ai_gen_id }}">
                        {% liquid
                          assign rating = product.metafields.reviews.rating.value | default: 0
                          assign review_count = product.metafields.reviews.rating_count | default: 0
                          assign rating_decimal = rating | round
                        %}
                        {% for i in (1..5) %}
                          <svg class="ai-featured-carousel-star-{{ ai_gen_id }} {% if i > rating_decimal %}ai-featured-carousel-star-empty-{{ ai_gen_id }}{% endif %}" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% endfor %}
                      </div>
                      {% if review_count > 0 %}
                        <span class="ai-featured-carousel-review-count-{{ ai_gen_id }}">({{ review_count }})</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="ai-featured-carousel-price-wrapper-{{ ai_gen_id }}">
                    <span class="ai-featured-carousel-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                    {% if on_sale %}
                      <span class="ai-featured-carousel-compare-price-{{ ai_gen_id }}">
                        {{ product.compare_at_price | money }}
                      </span>
                      {% if block.settings.show_discount_percentage %}
                        <span class="ai-featured-carousel-discount-{{ ai_gen_id }}">
                          -{{ discount_percentage }}%
                        </span>
                      {% endif %}
                    {% endif %}
                  </div>

                  <button
                    type="button"
                    class="ai-featured-carousel-button-{{ ai_gen_id }}"
                    data-add-to-cart
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    {{ block.settings.button_text }}
                  </button>
                </div>
              </product-card-{{ ai_gen_id }}>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="ai-featured-carousel-empty-{{ ai_gen_id }}">
        {{ 'collection-1' | placeholder_svg_tag }}
        <p>Select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</featured-product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.addToCartButton = this.querySelector('[data-add-to-cart]');
        if (this.addToCartButton) {
          this.addToCartButton.addEventListener('click', this.handleAddToCart.bind(this));
        }
      }

      handleAddToCart(event) {
        event.preventDefault();
        const variantId = this.addToCartButton.dataset.variantId;
        const originalText = this.addToCartButton.textContent;

        this.addToCartButton.textContent = 'Adding...';
        this.addToCartButton.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: 1
            }]
          })
        })
        .then(response => response.json())
        .then(data => {
          this.addToCartButton.textContent = 'Added!';
          setTimeout(() => {
            this.addToCartButton.textContent = originalText;
            this.addToCartButton.disabled = false;
          }, 2000);

          fetch('/cart.js')
            .then(response => response.json())
            .then(cart => {
              document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
                bubbles: true,
                detail: { cart }
              }));
            });
        })
        .catch(error => {
          console.error('Error:', error);
          this.addToCartButton.textContent = 'Error';
          setTimeout(() => {
            this.addToCartButton.textContent = originalText;
            this.addToCartButton.disabled = false;
          }, 2000);
        });
      }
    }

    class FeaturedProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerView = 4;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
        this.products = this.querySelectorAll('.ai-featured-carousel-product-{{ ai_gen_id }}');

        if (!this.track || this.products.length === 0) return;

        this.updateItemsPerView();
        this.setupEventListeners();
        this.updateButtons();

        window.addEventListener('resize', () => {
          this.updateItemsPerView();
          this.currentIndex = 0;
          this.updateCarousel();
        });
      }

      updateItemsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.itemsPerView = 1.2;
        } else if (width <= 989) {
          this.itemsPerView = 2;
        } else {
          this.itemsPerView = 4;
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
          isDragging = false;
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        const maxIndex = this.products.length - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        const productWidth = this.products[0].offsetWidth;
        const gap = {{ block.settings.product_gap }};
        const offset = this.currentIndex * (productWidth + gap);
        this.track.style.transform = `translateX(-${offset}px)`;
        this.updateButtons();
      }

      updateButtons() {
        if (!this.prevButton || !this.nextButton) return;

        this.prevButton.disabled = this.currentIndex === 0;
        const maxIndex = this.products.length - 1;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }
    }

    customElements.define('product-card-{{ ai_gen_id }}', ProductCard{{ ai_gen_id }});
    customElements.define('featured-product-carousel-{{ ai_gen_id }}', FeaturedProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured product carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to Cart"
    },
    {
      "type": "header",
      "content": "Product card features"
    },
    {
      "type": "checkbox",
      "id": "show_hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true,
      "info": "Requires product.metafields.reviews.rating and product.metafields.reviews.rating_count"
    },
    {
      "type": "checkbox",
      "id": "show_discount_percentage",
      "label": "Show discount percentage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "product_gap",
      "label": "Product spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "nav_button_size",
      "label": "Button size",
      "min": 32,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "nav_button_gap",
      "label": "Button spacing",
      "min": 4,
