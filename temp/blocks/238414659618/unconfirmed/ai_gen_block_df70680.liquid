{% doc %}
  @prompt
    Create a Shopify OS 2.0 Featured Products section. Build it using Shopify's native product objects and do not use placeholder cards or demo HTML.
    
    The section should look like a professional ecommerce product listing.
    
    Section
    Full width.
    White background.
    Large centered heading BEST SELLERS using the Anton font.
    Heading should be bold, uppercase, approximately 64px on desktop.
    Navigation buttons positioned at the top-right.
    Product Layout
    
    Display 4 complete product cards on desktop.
    
    Each card must use this exact structure:
    
    Product Image
    ↓
    
    Rating + Review Count
    
    ↓
    
    Product Title
    
    ↓
    
    Price Row
    
    ↓
    
    Offer Badge
    
    ↓
    
    Add to Cart Button
    Product Image
    Must be at the very top of the card.
    Occupy approximately 60% of the card height.
    Use Shopify's featured image.
    Use object-fit: contain.
    Never crop or zoom.
    Fixed image container.
    Same image height for every product.
    Rating
    
    Display immediately below the image.
    
    Example:
    
    ⭐ 4.8 | 120 Reviews
    
    Left aligned.
    
    Product Title
    
    Immediately below the rating.
    
    Requirements:
    
    Anton font
    Bold
    Left aligned
    Maximum 2 lines
    Same height on every card
    Price Row
    
    Display on one line.
    
    Example:
    
    ₹2,899 ₹2,499 -14% OFF
    
    Compare price:
    
    Grey
    Strikethrough
    
    Sale price:
    
    Larger
    Bold
    
    Discount:
    
    Green
    Bold
    Offer Badge
    
    Display directly below the price.
    
    Example:
    
    FREE SHIPPING + 3% PREPAID BONUS
    
    Rounded pill.
    
    Add to Cart
    
    Place at the bottom.
    
    Requirements:
    
    Full width
    Crimson red background
    White Anton text
    Fixed height
    Same position on every card
    Card Design
    White background
    Square corners (no border radius)
    Thin grey border
    No shadow
    Compact spacing
    Equal height
    Important
    
    Do not vertically center any content.
    
    Build the card from top to bottom.
    
    Do not use placeholder markup.
    
    Do not generate demo content.
    
    Do not hide any product information.
    
    Always render:
    
    Product Image
    Rating
    Review Count
    Product Title
    Compare Price
    Sale Price
    Discount
    Offer Badge
    Add to Cart Button
    
    If any information is unavailable, preserve the layout by showing an empty placeholder space instead of collapsing the card.
    
    Use Shopify's native product card structure and ensure every element is visible and properly aligned.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .ai-featured-products-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    display: block;
  }

  .ai-featured-products-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-products-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-featured-products-heading-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    color: {{ block.settings.heading_color }};
    margin: 0;
    letter-spacing: 1px;
  }

  .ai-featured-products-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border: 1px solid {{ block.settings.nav_border_color }};
    background-color: {{ block.settings.nav_bg_color }};
    color: {{ block.settings.nav_icon_color }};
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_bg_color }};
    border-color: {{ block.settings.nav_hover_border_color }};
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    overflow: hidden;
  }

  .ai-featured-products-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-featured-products-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    position: relative;
    background-color: #f9f9f9;
  }

  .ai-featured-products-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-featured-products-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-featured-products-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: {{ block.settings.rating_size }}px;
    color: {{ block.settings.rating_color }};
    margin-bottom: {{ block.settings.rating_spacing }}px;
    min-height: 20px;
  }

  .ai-featured-products-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
  }

  .ai-featured-products-title-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: calc({{ block.settings.title_size }}px * 1.3 * 2);
  }

  .ai-featured-products-price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: {{ block.settings.price_spacing }}px;
    flex-wrap: wrap;
    min-height: 24px;
  }

  .ai-featured-products-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-featured-products-sale-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.sale_price_size }}px;
    font-weight: 700;
    color: {{ block.settings.sale_price_color }};
  }

  .ai-featured-products-discount-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_size }}px;
    font-weight: 700;
    color: {{ block.settings.discount_color }};
  }

  .ai-featured-products-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.badge_border_radius }}px;
    margin-bottom: {{ block.settings.badge_spacing }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-height: 28px;
    display: flex;
    align-items: center;
  }

  .ai-featured-products-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: auto;
    height: {{ block.settings.button_height }}px;
    letter-spacing: 1px;
  }

  .ai-featured-products-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  @media screen and (max-width: 1024px) {
    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-featured-products-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .ai-featured-products-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-featured-products-image-wrapper-{{ ai_gen_id }} {
      height: calc({{ block.settings.image_height }}px * 0.7);
    }

    .ai-featured-products-content-{{ ai_gen_id }} {
      padding: 12px;
    }

    .ai-featured-products-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
      min-height: calc({{ block.settings.title_size }}px * 0.85 * 1.3 * 2);
    }
  }
{% endstyle %}

<featured-products-{{ ai_gen_id }} class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products-container-{{ ai_gen_id }}">
    <div class="ai-featured-products-header-{{ ai_gen_id }}">
      <h2 class="ai-featured-products-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <div class="ai-featured-products-nav-{{ ai_gen_id }}">
        <button class="ai-featured-products-nav-button-{{ ai_gen_id }}" data-nav="prev" aria-label="Previous products">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="ai-featured-products-nav-button-{{ ai_gen_id }}" data-nav="next" aria-label="Next products">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-featured-products-grid-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% assign products = block.settings.collection.products %}
        {% for product in products limit: block.settings.products_to_show %}
          <div class="ai-featured-products-card-{{ ai_gen_id }}">
            <div class="ai-featured-products-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-products-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-featured-products-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-featured-products-content-{{ ai_gen_id }}">
              <div class="ai-featured-products-rating-{{ ai_gen_id }}">
                {% if product.metafields.reviews.rating.value != blank %}
                  <span class="ai-featured-products-stars-{{ ai_gen_id }}">⭐</span>
                  <span>{{ product.metafields.reviews.rating.value }} | {{ product.metafields.reviews.rating_count }} Reviews</span>
                {% else %}
                  <span>&nbsp;</span>
                {% endif %}
              </div>

              <h3 class="ai-featured-products-title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>

              <div class="ai-featured-products-price-row-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-featured-products-compare-price-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                  <span class="ai-featured-products-sale-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                  {% assign discount_amount = product.compare_at_price | minus: product.price %}
                  {% assign discount_percent = discount_amount | times: 100 | divided_by: product.compare_at_price %}
                  <span class="ai-featured-products-discount-{{ ai_gen_id }}">
                    -{{ discount_percent }}% OFF
                  </span>
                {% else %}
                  <span class="ai-featured-products-sale-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                {% endif %}
              </div>

              <div class="ai-featured-products-badge-{{ ai_gen_id }}">
                {{ block.settings.offer_badge_text }}
              </div>

              <button
                class="ai-featured-products-add-to-cart-{{ ai_gen_id }}"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              >
                {{ block.settings.button_text }}
              </button>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="ai-featured-products-card-{{ ai_gen_id }}">
            <div class="ai-featured-products-image-wrapper-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
            <div class="ai-featured-products-content-{{ ai_gen_id }}">
              <div class="ai-featured-products-rating-{{ ai_gen_id }}">
                <span>&nbsp;</span>
              </div>
              <h3 class="ai-featured-products-title-{{ ai_gen_id }}">
                Select a collection to display products
              </h3>
              <div class="ai-featured-products-price-row-{{ ai_gen_id }}">
                <span>&nbsp;</span>
              </div>
              <div class="ai-featured-products-badge-{{ ai_gen_id }}">
                {{ block.settings.offer_badge_text }}
              </div>
              <button class="ai-featured-products-add-to-cart-{{ ai_gen_id }}" disabled>
                {{ block.settings.button_text }}
              </button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.productsPerPage = 4;
      }

      connectedCallback() {
        this.prevButton = this.querySelector('[data-nav="prev"]');
        this.nextButton = this.querySelector('[data-nav="next"]');
        this.grid = this.querySelector('.ai-featured-products-grid-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-featured-products-card-{{ ai_gen_id }}');
        this.addToCartButtons = this.querySelectorAll('.ai-featured-products-add-to-cart-{{ ai_gen_id }}');

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
          this.nextButton.addEventListener('click', () => this.navigate('next'));
          this.updateNavButtons();
        }

        this.addToCartButtons.forEach(button => {
          button.addEventListener('click', (e) => this.handleAddToCart(e));
        });
      }

      navigate(direction) {
        const totalProducts = this.cards.length;
        const maxIndex = Math.max(0, totalProducts - this.productsPerPage);

        if (direction === 'prev') {
          this.currentIndex = Math.max(0, this.currentIndex - this.productsPerPage);
        } else {
          this.currentIndex = Math.min(maxIndex, this.currentIndex + this.productsPerPage);
        }

        this.cards.forEach((card, index) => {
          if (index >= this.currentIndex && index < this.currentIndex + this.productsPerPage) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        this.updateNavButtons();
      }

      updateNavButtons() {
        const totalProducts = this.cards.length;
        const maxIndex = Math.max(0, totalProducts - this.productsPerPage);

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }

      handleAddToCart(e) {
        const button = e.currentTarget;
        const variantId = button.dataset.variantId;

        if (!variantId) return;

        const formData = {
          items: [{
            id: variantId,
            quantity: 1
          }]
        };

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        })
        .then(response => response.json())
        .then(data => {
          window.dispatchEvent(new Event('cart:refresh'));
          
          const originalText = button.textContent;
          button.textContent = 'ADDED!';
          button.style.backgroundColor = '#28a745';
          
          setTimeout(() => {
            button.textContent = originalText;
            button.style.backgroundColor = '';
          }, 2000);
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
        });
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

