{% doc %}
  @prompt
    Create a Shopify OS 2.0 Featured Products section with a premium ecommerce design.
    
    Section
    Full-width section.
    White background.
    Large centered heading BEST SELLERS.
    Font: Anton.
    Bold, uppercase.
    Navigation arrows positioned at the top-right.
    Product Cards
    
    Display 4 product cards in one horizontal row on desktop.
    
    Each card should have:
    
    White background.
    Black text.
    Thin light grey border.
    No shadow.
    No rounded corners.
    Equal height and width.
    Clean premium ecommerce appearance.
    Card Layout
    
    Arrange the content in this exact order:
    
    Product Image
    Rating + Review Count
    Product Title
    Price Row
    Offer Badge
    Add to Cart Button
    Product Image
    Place at the very top.
    Occupy approximately 60% of the card height.
    Use Shopify featured image.
    Keep the entire image visible.
    Use object-fit: contain.
    Never crop or stretch.
    Same image height for every product.
    Rating
    
    Place directly below the image.
    
    Example:
    
    ⭐ 4.8 | 120 Reviews
    
    Left aligned.
    Black text.
    Product Title
    Left aligned.
    Black.
    Anton font.
    Bold.
    Maximum 2 lines.
    Price Row
    
    Display on one line.
    
    Example:
    
    ₹2,899 ₹2,499 -14% OFF
    
    Requirements:
    
    Compare-at price: Grey with strikethrough.
    Sale price: Black, bold, larger.
    Discount: Green.
    Offer Badge
    
    Display below the price.
    
    Example:
    
    FREE SHIPPING + 3% PREPAID BONUS
    
    Full-width pill.
    Crimson red background.
    White text.
    Add to Cart Button
    
    Place at the bottom of the card.
    
    Requirements:
    
    Full width.
    No rounded corners.
    Dark Crimson Red background (#8B0000).
    White Anton text.
    Bold.
    Same height on every card.
    Important
    
    Use Shopify's native product card structure, not placeholder or demo cards.
    
    Keep all content left aligned except the product image.
    
    Do not vertically center the content.
    
    Every card should have identical spacing, height, and alignment.
    
    The final result should look like a premium ecommerce product listing with white product cards, black typography, and a dark crimson red Add to Cart button with white text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-products-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    display: block;
  }

  .ai-featured-products-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-products-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-featured-products-heading-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    color: {{ block.settings.heading_color }};
    margin: 0;
    letter-spacing: 1px;
  }

  .ai-featured-products-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border: 1px solid {{ block.settings.arrow_border_color }};
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    color: {{ block.settings.arrow_hover_color }};
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-featured-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-product-card-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font-size: {{ block.settings.rating_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-card-rating-{{ ai_gen_id }} .star {
    color: {{ block.settings.star_color }};
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }

  .ai-product-card-price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .ai-product-card-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | plus: 2 }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-product-card-discount-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_size }}px;
    font-weight: 700;
    color: {{ block.settings.discount_color }};
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    text-align: center;
    font-size: {{ block.settings.badge_size }}px;
    font-weight: 600;
    margin-bottom: 12px;
    border-radius: 20px;
  }

  .ai-product-card-button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: auto;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: block;
    text-align: center;
  }

  .ai-product-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 989px) {
    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-featured-products-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-product-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products-nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<featured-products-{{ ai_gen_id }} class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products-container-{{ ai_gen_id }}">
    <div class="ai-featured-products-header-{{ ai_gen_id }}">
      <h2 class="ai-featured-products-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <div class="ai-featured-products-nav-{{ ai_gen_id }}">
        <button class="ai-featured-products-nav-button-{{ ai_gen_id }}" data-prev aria-label="Previous products">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-featured-products-nav-button-{{ ai_gen_id }}" data-next aria-label="Next products">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-featured-products-grid-{{ ai_gen_id }}">
      {% if block.settings.collection != blank %}
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-card-image-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="ai-product-card-content-{{ ai_gen_id }}">
              {% if block.settings.show_rating %}
                <div class="ai-product-card-rating-{{ ai_gen_id }}">
                  <span class="star">⭐</span>
                  <span>{{ block.settings.default_rating }} | {{ block.settings.default_reviews }} Reviews</span>
                </div>
              {% endif %}

              <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                  {{ product.title }}
                </a>
              </h3>

              <div class="ai-product-card-price-row-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-product-card-compare-price-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                {% endif %}
                <span class="ai-product-card-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </span>
                {% if product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="ai-product-card-discount-{{ ai_gen_id }}">
                    -{{ discount_percent }}% OFF
                  </span>
                {% endif %}
              </div>

              {% if block.settings.show_badge and block.settings.badge_text != blank %}
                <div class="ai-product-card-badge-{{ ai_gen_id }}">
                  {{ block.settings.badge_text }}
                </div>
              {% endif %}

              <a href="{{ product.url }}" class="ai-product-card-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-product-card-image-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>

            <div class="ai-product-card-content-{{ ai_gen_id }}">
              {% if block.settings.show_rating %}
                <div class="ai-product-card-rating-{{ ai_gen_id }}">
                  <span class="star">⭐</span>
                  <span>{{ block.settings.default_rating }} | {{ block.settings.default_reviews }} Reviews</span>
                </div>
              {% endif %}

              <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                Sample Product Title
              </h3>

              <div class="ai-product-card-price-row-{{ ai_gen_id }}">
                <span class="ai-product-card-compare-price-{{ ai_gen_id }}">₹2,899</span>
                <span class="ai-product-card-price-{{ ai_gen_id }}">₹2,499</span>
                <span class="ai-product-card-discount-{{ ai_gen_id }}">-14% OFF</span>
              </div>

              {% if block.settings.show_badge and block.settings.badge_text != blank %}
                <div class="ai-product-card-badge-{{ ai_gen_id }}">
                  {{ block.settings.badge_text }}
                </div>
              {% endif %}

              <a href="#" class="ai-product-card-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.itemsPerPage = 4;
      }

      connectedCallback() {
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.grid = this.querySelector('.ai-featured-products-grid-{{ ai_gen_id }}');
        this.cards = Array.from(this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}'));
        this.totalPages = Math.ceil(this.cards.length / this.itemsPerPage);

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.navigate(-1));
          this.nextButton.addEventListener('click', () => this.navigate(1));
          this.updateButtons();
        }
      }

      navigate(direction) {
        this.currentPage += direction;
        if (this.currentPage < 0) this.currentPage = 0;
        if (this.currentPage >= this.totalPages) this.currentPage = this.totalPages - 1;

        const startIndex = this.currentPage * this.itemsPerPage;
        this.cards.forEach((card, index) => {
          if (index >= startIndex && index < startIndex + this.itemsPerPage) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        this.updateButtons();
      }

      updateButtons() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentPage === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentPage >= this.totalPages - 1;
        }
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

