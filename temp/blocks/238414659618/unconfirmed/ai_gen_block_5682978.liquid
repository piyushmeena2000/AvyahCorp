{% doc %}
  @prompt
    Create a Shopify OS 2.0 Featured Product Listing section. Focus only on the visual design. Do not add any slider or functionality yet.
    
    The section should look like a premium ecommerce product listing similar to top D2C brands.
    
    Layout
    Full-width section with a white background.
    Large centered heading "BEST SELLERS" using the Anton font.
    Heading should be bold, uppercase, and around 60–70px on desktop.
    Keep the spacing between the heading and product cards very small.
    Product Grid
    
    Display 4 product cards in one row on desktop.
    
    The cards should be:
    
    White background
    Thin light-grey border
    Small border radius (6–8px)
    Premium clean look
    Equal width and height
    Consistent spacing between cards
    Product Card Layout
    
    The layout inside every card should follow exactly this order:
    
    Product Image
    Rating & Review Count
    Product Title
    Price Row
    Offer Badge (optional)
    Add to Cart Button
    Product Image
    
    The product image is the hero element.
    
    Requirements:
    
    Occupy about 65% of the card height.
    Large image.
    Perfectly centered.
    Never crop the product.
    Never zoom.
    Keep original aspect ratio using object-fit: contain.
    Fixed image container so every card has identical image height.
    Product Title
    Center aligned.
    Maximum 2 lines.
    Bold.
    Anton font.
    Equal height on every card.
    Price
    
    Display on one line:
    
    Compare-at price (grey, struck through)
    Sale price (large and bold)
    Discount percentage (green)
    
    Everything aligned horizontally.
    
    Offer Badge
    
    Optional rounded pill below the price.
    
    Add to Cart Button
    Full width.
    Fixed at the bottom.
    Same height on every card.
    Crimson red background.
    White Anton text.
    Important
    
    Do not redesign this section in your own style.
    
    Avoid oversized white spaces.
    
    The product image must dominate the card.
    
    The content must be compact below the image.
    
    Every card must have identical proportions and look like a professional ecommerce product listing rather than a generic Shopify card.
    
    Only build the visual layout. Do not add carousel functionality, animations, scrolling, navigation, or JavaScript yet.
    
    This prompt is intentionally short because Shopify AI tends to produce much better UI when it's only responsible for the layout. Once you're happy with the design, I'll give you Part 2, which will add:
    
    Horizontal carousel
    Touchpad drag
    Mouse drag
    Mobile swipe
    Navigation arrows
    AJAX Add to Cart
    All Theme Editor settings
    
    without changing the design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .ai-featured-products-{{ ai_gen_id }} {
    width: 100%;
    background-color: #ffffff;
    padding: 40px 20px;
    display: block;
  }

  .ai-featured-products-heading-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: 60px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 20px 0;
    letter-spacing: 1px;
  }

  .ai-featured-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .ai-product-image-container-{{ ai_gen_id }} {
    width: 100%;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: #ffffff;
    flex-shrink: 0;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
    opacity: 0.3;
  }

  .ai-product-content-{{ ai_gen_id }} {
    padding: 12px 16px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-product-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    color: #666666;
    min-height: 20px;
  }

  .ai-product-stars-{{ ai_gen_id }} {
    color: #ffa500;
    font-size: 14px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 42px;
    text-transform: uppercase;
  }

  .ai-product-price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    min-height: 28px;
  }

  .ai-product-compare-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: #999999;
    text-decoration: line-through;
  }

  .ai-product-sale-price-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: #000000;
  }

  .ai-product-discount-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: #00a651;
  }

  .ai-product-offer-badge-{{ ai_gen_id }} {
    background-color: #f0f0f0;
    color: #333333;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    text-align: center;
    margin: 4px 0;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }} {
    background-color: #dc143c;
    color: #ffffff;
    font-family: 'Anton', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    border: none;
    border-radius: 6px;
    padding: 14px 20px;
    cursor: pointer;
    width: 100%;
    margin-top: auto;
    letter-spacing: 0.5px;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: #b8112f;
  }

  @media screen and (max-width: 1200px) {
    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-featured-products-heading-{{ ai_gen_id }} {
      font-size: 40px;
    }

    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .ai-product-image-container-{{ ai_gen_id }} {
      height: 200px;
      padding: 12px;
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: 14px;
      min-height: 38px;
    }

    .ai-product-sale-price-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-product-add-to-cart-{{ ai_gen_id }} {
      font-size: 14px;
      padding: 12px 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-featured-products-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-featured-products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-featured-products-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-featured-products-grid-{{ ai_gen_id }}">
    {% if block.settings.collection != blank %}
      {% for product in block.settings.collection.products limit: 4 %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-image-container-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-product-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-product-content-{{ ai_gen_id }}">
            <div class="ai-product-rating-{{ ai_gen_id }}">
              {% if block.settings.show_ratings %}
                <span class="ai-product-stars-{{ ai_gen_id }}">★★★★★</span>
                <span>({{ block.settings.review_count }})</span>
              {% endif %}
            </div>

            <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

            <div class="ai-product-price-row-{{ ai_gen_id }}">
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                <span class="ai-product-sale-price-{{ ai_gen_id }}">{{ product.price | money }}</span>
                {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="ai-product-discount-{{ ai_gen_id }}">({{ discount }}% OFF)</span>
              {% else %}
                <span class="ai-product-sale-price-{{ ai_gen_id }}">{{ product.price | money }}</span>
              {% endif %}
            </div>

            {% if block.settings.offer_text != blank %}
              <div class="ai-product-offer-badge-{{ ai_gen_id }}">{{ block.settings.offer_text }}</div>
            {% endif %}

            <button class="ai-product-add-to-cart-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-image-container-{{ ai_gen_id }}">
            <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          </div>

          <div class="ai-product-content-{{ ai_gen_id }}">
            <div class="ai-product-rating-{{ ai_gen_id }}">
              {% if block.settings.show_ratings %}
                <span class="ai-product-stars-{{ ai_gen_id }}">★★★★★</span>
                <span>({{ block.settings.review_count }})</span>
              {% endif %}
            </div>

            <h3 class="ai-product-title-{{ ai_gen_id }}">SAMPLE PRODUCT TITLE</h3>

            <div class="ai-product-price-row-{{ ai_gen_id }}">
              <span class="ai-product-compare-price-{{ ai_gen_id }}">₹999</span>
              <span class="ai-product-sale-price-{{ ai_gen_id }}">₹699</span>
              <span class="ai-product-discount-{{ ai_gen_id }}">(30% OFF)</span>
            </div>

            {% if block.settings.offer_text != blank %}
              <div class="ai-product-offer-badge-{{ ai_gen_id }}">{{ block.settings.offer_text }}</div>
            {% endif %}

            <button class="ai-product-add-to-cart-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_ratings",
      "label": "Show ratings",
      "default": true
    },
    {
      "type": "range",
      "id": "review_count",
      "label": "Review count",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 120
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer badge text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "ADD TO CART"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
