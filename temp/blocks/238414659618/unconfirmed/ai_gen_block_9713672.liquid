{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-products-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    display: block;
  }

  .ai-featured-products-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-products-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-featured-products-heading-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    color: {{ block.settings.heading_color }};
    margin: 0;
    letter-spacing: 1px;
  }

  .ai-featured-products-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border: 1px solid {{ block.settings.arrow_border_color }};
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    border-radius: 0;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    color: {{ block.settings.arrow_hover_color }};
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-products-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-featured-products-carousel-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: {{ block.settings.card_gap }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
  }

  .ai-featured-products-carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-featured-products-carousel-{{ ai_gen_id }}:active {
    cursor: grabbing;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: 0;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    scroll-snap-align: start;
    width: calc((100% - ({{ block.settings.card_gap }}px * 3)) / 4);
    min-height: 640px;
    padding: 16px;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
    background-color: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    flex-shrink: 0;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
  }

  .ai-product-card-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: {{ block.settings.rating_size }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-card-rating-{{ ai_gen_id }} .star {
    color: {{ block.settings.star_color }};
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
    min-height: 50px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
    text-align: left;
  }

  .ai-product-card-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card-price-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
    text-align: left;
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-card-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | plus: 2 }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-product-card-discount-{{ ai_gen_id }} {
    font-size: {{ block.settings.discount_size }}px;
    font-weight: 700;
    color: {{ block.settings.discount_color }};
    margin-left: auto;
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    text-align: center;
    font-size: {{ block.settings.badge_size }}px;
    font-weight: 600;
    border-radius: 20px;
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-card-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 16px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 0;
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: auto;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: block;
    text-align: center;
    line-height: 1.2;
  }

  .ai-product-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 989px) {
    .ai-product-card-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.card_gap }}px) / 2);
      min-height: 560px;
    }

    .ai-featured-products-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-product-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
      min-height: 46px;
    }

    .ai-product-card-image-wrapper-{{ ai_gen_id }} {
      height: 340px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-product-card-{{ ai_gen_id }} {
      width: calc(83.33% - {{ block.settings.card_gap }}px);
      min-height: 520px;
    }

    .ai-product-card-image-wrapper-{{ ai_gen_id }} {
      height: 300px;
    }

    .ai-product-card-title-{{ ai_gen_id }} {
      min-height: 42px;
    }
  }
{% endstyle %}

<featured-products-{{ ai_gen_id }} class="ai-featured-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-products-container-{{ ai_gen_id }}">
    <div class="ai-featured-products-header-{{ ai_gen_id }}">
      <h2 class="ai-featured-products-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <div class="ai-featured-products-nav-{{ ai_gen_id }}">
        <button class="ai-featured-products-nav-button-{{ ai_gen_id }}" data-prev aria-label="Previous products">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-featured-products-nav-button-{{ ai_gen_id }}" data-next aria-label="Next products">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-featured-products-carousel-{{ ai_gen_id }}" data-carousel>
      {% if block.settings.collection != blank %}
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-card-image-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="ai-product-card-content-{{ ai_gen_id }}">
              {% if block.settings.show_rating %}
                <div class="ai-product-card-rating-{{ ai_gen_id }}">
                  <span class="star">⭐</span>
                  <span>{{ block.settings.default_rating }} | {{ block.settings.default_reviews }} Reviews</span>
                </div>
              {% endif %}

              <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>
              </h3>

              <div class="ai-product-card-price-row-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-product-card-compare-price-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                {% endif %}
                <span class="ai-product-card-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </span>
                {% if product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="ai-product-card-discount-{{ ai_gen_id }}">
                    -{{ discount_percent }}% OFF
                  </span>
                {% endif %}
              </div>

              {% if block.settings.show_badge and block.settings.badge_text != blank %}
                <div class="ai-product-card-badge-{{ ai_gen_id }}">
                  {{ block.settings.badge_text }}
                </div>
              {% endif %}

              <a href="{{ product.url }}" class="ai-product-card-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDown = false;
        this.startX = 0;
        this.scrollLeft = 0;
      }

      connectedCallback() {
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.carousel = this.querySelector('[data-carousel]');
        this.cards = Array.from(this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}'));

        if (this.prevButton && this.nextButton && this.carousel) {
          this.prevButton.addEventListener('click', () => this.navigate(-1));
          this.nextButton.addEventListener('click', () => this.navigate(1));
          this.updateButtons();

          this.carousel.addEventListener('scroll', () => this.updateButtons());

          this.carousel.addEventListener('mousedown', (e) => {
            this.isDown = true;
            this.startX = e.pageX - this.carousel.offsetLeft;
            this.scrollLeft = this.carousel.scrollLeft;
          });

          this.carousel.addEventListener('mouseleave', () => {
            this.isDown = false;
          });

          this.carousel.addEventListener('mouseup', () => {
            this.isDown = false;
          });

          this.carousel.addEventListener('mousemove', (e) => {
            if (!this.isDown) return;
            e.preventDefault();
            const x = e.pageX - this.carousel.offsetLeft;
            const walk = (x - this.startX) * 2;
            this.carousel.scrollLeft = this.scrollLeft - walk;
          });
        }
      }

      navigate(direction) {
        if (!this.carousel || this.cards.length === 0) return;

        const cardWidth = this.cards[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.carousel).gap) || 0;
        const scrollAmount = cardWidth + gap;

        this.carousel.scrollBy({
          left: direction * scrollAmount,
          behavior: 'smooth'
        });
      }

      updateButtons() {
        if (!this.carousel || !this.prevButton || !this.nextButton) return;

        const isAtStart = this.carousel.scrollLeft <= 0;
        const isAtEnd = this.carousel.scrollLeft + this.carousel.offsetWidth >= this.carousel.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 20,
      "max": 80,
