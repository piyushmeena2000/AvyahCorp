{% doc %}
  @prompt
    Create a premium Shopify Online Store 2.0 Featured Collection section for a modern D2C snack brand.
    
    The design should feel comparable to SuperYou, Apple, Nothing, AG1, and premium Shopify Plus stores.
    
    OVERALL DESIGN
    
    • The entire section background should be Crimson Red (#D52528).
    • Inside the section, place one large floating WHITE container.
    • The white container should have rounded corners (24px), a soft shadow, generous padding (56-64px), and a maximum width of about 1440px.
    • The section should look luxurious, minimal, and conversion-focused.
    
    HEADER
    
    Eyebrow:
    OUR COLLECTION
    
    Heading:
    Find Your Perfect Snack
    
    Description:
    Choose from our range of healthy multigrain snack bars, combo packs, and share boxes.
    
    Center align all header content.
    
    FILTER TABS
    
    Create premium pill tabs:
    
    • Single
    • Sharebox
    • Combo
    
    Active tab:
    • Crimson Red background
    • White text
    
    Inactive tabs:
    • White background
    • Light gray border
    • Smooth hover transition
    
    PRODUCT LAYOUT
    
    Desktop:
    • Exactly 4 products visible in one horizontal row.
    
    Tablet:
    • Exactly 3 products visible in one horizontal row.
    
    Mobile:
    • Horizontally scrollable carousel showing large product cards with snap scrolling.
    
    Never stack products vertically.
    
    PRODUCT CARDS
    
    Each product card should be WHITE.
    
    Use:
    • Rounded corners
    • Soft shadow
    • Black product title
    • Dark gray description
    • Black price
    • Gold rating stars
    • Crimson Add to Cart button
    • Wishlist icon
    • Quick View button
    • Bestseller badge
    • Discount badge
    
    Cards should be large, equal height, equal width, perfectly aligned, and have premium spacing.
    
    THEME EDITOR SETTINGS
    
    Expose editable settings for:
    
    • Eyebrow
    • Heading
    • Description
    • Section Background Color
    • Container Background Color
    • Container Radius
    • Container Shadow
    • Section Padding
    • Product Gap
    • Products Per Row
    • Collection for Single
    • Collection for Sharebox
    • Collection for Combo
    • Card Background Color
    • Card Radius
    • Card Shadow
    • Button Colors
    • Heading Color
    • Price Color
    • Show/Hide Ratings
    • Show/Hide Wishlist
    • Show/Hide Quick View
    • Show/Hide Discount Badge
    • Show/Hide Bestseller Badge
    
    The section must dynamically load Shopify collections and be fully customizable from the Shopify Theme Editor without editing code.
    
    The final result should look like it was designed by a premium Shopify Plus agency, with excellent spacing, clean typography, and a high-end shopping experience.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    width: 100%;
  }

  .ai-featured-collection-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    background-color: {{ block.settings.container_bg_color }};
    border-radius: {{ block.settings.container_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    box-shadow: {{ block.settings.container_shadow_x }}px {{ block.settings.container_shadow_y }}px {{ block.settings.container_shadow_blur }}px {{ block.settings.container_shadow_color }};
  }

  .ai-featured-collection-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-featured-collection-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .ai-featured-collection-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-featured-collection-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-featured-collection-tabs-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-featured-collection-tab-{{ ai_gen_id }} {
    padding: 12px 32px;
    border-radius: {{ block.settings.tab_radius }}px;
    border: 1px solid {{ block.settings.tab_border_color }};
    background-color: {{ block.settings.tab_bg_color }};
    color: {{ block.settings.tab_text_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 16px;
    font-weight: 500;
  }

  .ai-featured-collection-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg_color }};
    border-color: {{ block.settings.tab_hover_border_color }};
  }

  .ai-featured-collection-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_bg_color }};
  }

  .ai-featured-collection-products-{{ ai_gen_id }} {
    display: none;
  }

  .ai-featured-collection-products-{{ ai_gen_id }}.active {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row_desktop }}, 1fr);
    gap: {{ block.settings.product_gap }}px;
  }

  .ai-featured-collection-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_radius }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .ai-featured-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-featured-collection-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-featured-collection-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection-badges-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
  }

  .ai-featured-collection-badge-{{ ai_gen_id }} {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-featured-collection-badge-bestseller-{{ ai_gen_id }} {
    background-color: {{ block.settings.bestseller_bg_color }};
    color: {{ block.settings.bestseller_text_color }};
  }

  .ai-featured-collection-badge-discount-{{ ai_gen_id }} {
    background-color: {{ block.settings.discount_bg_color }};
    color: {{ block.settings.discount_text_color }};
  }

  .ai-featured-collection-wishlist-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection-wishlist-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-featured-collection-wishlist-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    stroke: #000000;
    fill: none;
    stroke-width: 2;
  }

  .ai-featured-collection-card-content-{{ ai_gen_id }} {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-featured-collection-card-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.card_description_color }};
    margin: 0 0 12px;
    line-height: 1.5;
    flex-grow: 1;
  }

  .ai-featured-collection-card-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-featured-collection-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.star_color }};
  }

  .ai-featured-collection-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
    margin-bottom: 16px;
  }

  .ai-featured-collection-card-actions-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: 14px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-featured-collection-quick-view-{{ ai_gen_id }} {
    padding: 14px 20px;
    background-color: {{ block.settings.quick_view_bg_color }};
    color: {{ block.settings.quick_view_text_color }};
    border: 1px solid {{ block.settings.quick_view_border_color }};
    border-radius: {{ block.settings.button_radius }}px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .ai-featured-collection-quick-view-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.quick_view_hover_bg_color }};
    border-color: {{ block.settings.quick_view_hover_border_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-featured-collection-products-{{ ai_gen_id }}.active {
      grid-template-columns: repeat({{ block.settings.products_per_row_tablet }}, 1fr);
    }

    .ai-featured-collection-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-featured-collection-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-products-{{ ai_gen_id }}.active {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 16px;
      -webkit-overflow-scrolling: touch;
    }

    .ai-featured-collection-card-{{ ai_gen_id }} {
      min-width: 280px;
      scroll-snap-align: start;
    }

    .ai-featured-collection-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-featured-collection-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.5 }}px;
    }

    .ai-featured-collection-tabs-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }

    .ai-featured-collection-tab-{{ ai_gen_id }} {
      padding: 10px 24px;
      font-size: 14px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection-container-{{ ai_gen_id }}">
    <div class="ai-featured-collection-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-featured-collection-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-featured-collection-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="ai-featured-collection-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}
    </div>

    <div class="ai-featured-collection-tabs-{{ ai_gen_id }}">
      <button class="ai-featured-collection-tab-{{ ai_gen_id }} active" data-tab="single">
        {{ block.settings.tab_single_label }}
      </button>
      <button class="ai-featured-collection-tab-{{ ai_gen_id }}" data-tab="sharebox">
        {{ block.settings.tab_sharebox_label }}
      </button>
      <button class="ai-featured-collection-tab-{{ ai_gen_id }}" data-tab="combo">
        {{ block.settings.tab_combo_label }}
      </button>
    </div>

    <div class="ai-featured-collection-products-{{ ai_gen_id }} active" data-collection="single">
      {% if block.settings.collection_single != blank %}
        {% for product in block.settings.collection_single.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection-card-{{ ai_gen_id }}">
            <div class="ai-featured-collection-card-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-collection-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-featured-collection-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_wishlist %}
                <button class="ai-featured-collection-wishlist-{{ ai_gen_id }}" aria-label="Add to wishlist">
                  <svg class="ai-featured-collection-wishlist-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
              {% endif %}

              <div class="ai-featured-collection-badges-{{ ai_gen_id }}">
                {% if block.settings.show_bestseller_badge and product.metafields.custom.bestseller %}
                  <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-bestseller-{{ ai_gen_id }}">
                    Bestseller
                  </span>
                {% endif %}
                {% if block.settings.show_discount_badge and product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-discount-{{ ai_gen_id }}">
                    -{{ discount_percent }}%
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="ai-featured-collection-card-content-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              
              {% if product.description != blank %}
                <p class="ai-featured-collection-card-description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: 80 }}
                </p>
              {% endif %}

              {% if block.settings.show_ratings %}
                <div class="ai-featured-collection-card-rating-{{ ai_gen_id }}">
                  {% for i in (1..5) %}
                    <svg class="ai-featured-collection-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="ai-featured-collection-card-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <div class="ai-featured-collection-card-actions-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-featured-collection-add-to-cart-{{ ai_gen_id }}">
                  Add to Cart
                </a>
                {% if block.settings.show_quick_view %}
                  <button class="ai-featured-collection-quick-view-{{ ai_gen_id }}" aria-label="Quick view">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="text-align: center; color: #666; padding: 40px;">Please select a collection for Single products</p>
      {% endif %}
    </div>

    <div class="ai-featured-collection-products-{{ ai_gen_id }}" data-collection="sharebox">
      {% if block.settings.collection_sharebox != blank %}
        {% for product in block.settings.collection_sharebox.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection-card-{{ ai_gen_id }}">
            <div class="ai-featured-collection-card-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-collection-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-featured-collection-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_wishlist %}
                <button class="ai-featured-collection-wishlist-{{ ai_gen_id }}" aria-label="Add to wishlist">
                  <svg class="ai-featured-collection-wishlist-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
              {% endif %}

              <div class="ai-featured-collection-badges-{{ ai_gen_id }}">
                {% if block.settings.show_bestseller_badge and product.metafields.custom.bestseller %}
                  <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-bestseller-{{ ai_gen_id }}">
                    Bestseller
                  </span>
                {% endif %}
                {% if block.settings.show_discount_badge and product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-discount-{{ ai_gen_id }}">
                    -{{ discount_percent }}%
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="ai-featured-collection-card-content-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              
              {% if product.description != blank %}
                <p class="ai-featured-collection-card-description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: 80 }}
                </p>
              {% endif %}

              {% if block.settings.show_ratings %}
                <div class="ai-featured-collection-card-rating-{{ ai_gen_id }}">
                  {% for i in (1..5) %}
                    <svg class="ai-featured-collection-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="ai-featured-collection-card-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <div class="ai-featured-collection-card-actions-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-featured-collection-add-to-cart-{{ ai_gen_id }}">
                  Add to Cart
                </a>
                {% if block.settings.show_quick_view %}
                  <button class="ai-featured-collection-quick-view-{{ ai_gen_id }}" aria-label="Quick view">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="text-align: center; color: #666; padding: 40px;">Please select a collection for Sharebox products</p>
      {% endif %}
    </div>

    <div class="ai-featured-collection-products-{{ ai_gen_id }}" data-collection="combo">
      {% if block.settings.collection_combo != blank %}
        {% for product in block.settings.collection_combo.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection-card-{{ ai_gen_id }}">
            <div class="ai-featured-collection-card-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-collection-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-featured-collection-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_wishlist %}
                <button class="ai-featured-collection-wishlist-{{ ai_gen_id }}" aria-label="Add to wishlist">
                  <svg class="ai-featured-collection-wishlist-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
              {% endif %}

              <div class="ai-featured-collection-badges-{{ ai_gen_id }}">
                {% if block.settings.show_bestseller_badge and product.metafields.custom.bestseller %}
                  <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-bestseller-{{ ai_gen_id }}">
                    Bestseller
                  </span>
                {% endif %}
                {% if block.settings.show_discount_badge and product.compare_at_price > product.price %}
                  {% assign discount_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <span class="ai-featured-collection-badge-{{ ai_gen_id }} ai-featured-collection-badge-discount-{{ ai_gen_id }}">
                    -{{ discount_percent }}%
                  </span>
                {% endif %}
              </div>
            </div>

            <div class="ai-featured-collection-card-content-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              
              {% if product.description != blank %}
                <p class="ai-featured-collection-card-description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: 80 }}
                </p>
              {% endif %}

              {% if block.settings.show_ratings %}
                <div class="ai-featured-collection-card-rating-{{ ai_gen_id }}">
                  {% for i in (1..5) %}
                    <svg class="ai-featured-collection-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="ai-featured-collection-card-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <div class="ai-featured-collection-card-actions-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-featured-collection-add-to-cart-{{ ai_gen_id }}">
                  Add to Cart
                </a>
                {% if block.settings.show_quick_view %}
                  <button class="ai-featured-collection-quick-view-{{ ai_gen_id }}" aria-label="Quick view">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="text-align: center; color: #666; padding: 40px;">Please select a collection for Combo products</p>
      {% endif %}
    </div>
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-featured-collection-tab-{{ ai_gen_id }}');
        this.collections = this.querySelectorAll('.ai-featured-collection-products-{{ ai_gen_id }}');
        
        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => this.switchTab(tab));
        });
      }

      switchTab(clickedTab) {
        const targetCollection = clickedTab.getAttribute('data-tab');
        
        this.tabs.forEach(tab => tab.classList.remove('active'));
        clickedTab.classList.add('active');
        
        this.collections.forEach(collection => {
          if (collection.getAttribute('data-collection') === targetCollection) {
            collection.classList.add('active');
          } else {
            collection.classList.remove('active');
          }
        });
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

