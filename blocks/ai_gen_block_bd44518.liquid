{% doc %}
  @prompt
    Create a new Shopify OS 2.0 section called "Benefits Marquee" inspired by the attached reference, but replace company logos with benefit items. Each item should contain an icon uploaded through the Shopify Theme Editor (Image Picker) and a title using the Anton font. Do not hardcode icons or text.
    
    The section should have a full-width dark crimson red background (#8B0000) with white icons and white text. Create a smooth, seamless infinite marquee that scrolls from right to left with no jump or flicker. Duplicate the items internally to create a true infinite loop. Add an option to pause the animation on hover and allow animation speed and direction to be changed.
    
    Each benefit should be a Shopify block with:
    
    Icon (Image Picker)
    Benefit Title
    Optional Link
    Open in New Tab
    
    Expose all settings in the Shopify Theme Editor, including:
    
    Background color
    Text color
    Icon size (Desktop/Tablet/Mobile)
    Font size (Desktop/Tablet/Mobile)
    Item spacing
    Icon-to-text spacing
    Section padding
    Animation speed
    Animation direction
    Pause on hover
    Desktop/Tablet/Mobile visibility
    
    The section must be fully responsive, Shopify OS 2.0 compatible, use separate CSS and JavaScript files, and follow Shopify best practices with clean, production-ready code. The final design should be minimal, premium, and optimized for performance.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .ai-benefits-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 0;
    overflow: hidden;
    position: relative;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-marquee-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_tablet }}px 0;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-marquee-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 0;
    }
  }

  .ai-benefits-marquee-{{ ai_gen_id }}--hide-desktop {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-marquee-{{ ai_gen_id }}--hide-tablet {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-marquee-{{ ai_gen_id }}--hide-mobile {
      display: none;
    }
  }

  .ai-benefits-marquee__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing_desktop }}px;
    animation: ai-benefits-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    animation-direction: {% if block.settings.animation_direction == 'left' %}normal{% else %}reverse{% endif %};
    will-change: transform;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-marquee__track-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-marquee__track-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing_mobile }}px;
    }
  }

  {% if block.settings.pause_on_hover %}
    .ai-benefits-marquee-{{ ai_gen_id }}:hover .ai-benefits-marquee__track-{{ ai_gen_id }} {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes ai-benefits-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-benefits-marquee__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_spacing_desktop }}px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-marquee__item-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_text_spacing_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-marquee__item-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_text_spacing_mobile }}px;
    }
  }

  .ai-benefits-marquee__item-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: inherit;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }

  .ai-benefits-marquee__item-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-benefits-marquee__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_desktop }}px;
    height: {{ block.settings.icon_size_desktop }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-marquee__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_tablet }}px;
      height: {{ block.settings.icon_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-marquee__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }

  .ai-benefits-marquee__icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .ai-benefits-marquee__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.text_color }};
    border-radius: 4px;
    opacity: 0.3;
  }

  .ai-benefits-marquee__title-{{ ai_gen_id }} {
    font-family: 'Anton', sans-serif;
    font-size: {{ block.settings.font_size_desktop }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-marquee__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-marquee__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }

  .ai-benefits-marquee__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    opacity: 0.7;
  }
{% endstyle %}

<benefits-marquee-{{ ai_gen_id }}
  class="ai-benefits-marquee-{{ ai_gen_id }}
    {% unless block.settings.show_on_desktop %}ai-benefits-marquee-{{ ai_gen_id }}--hide-desktop{% endunless %}
    {% unless block.settings.show_on_tablet %}ai-benefits-marquee-{{ ai_gen_id }}--hide-tablet{% endunless %}
    {% unless block.settings.show_on_mobile %}ai-benefits-marquee-{{ ai_gen_id }}--hide-mobile{% endunless %}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign has_items = false
    for i in (1..8)
      assign icon_key = 'icon_' | append: i
      assign title_key = 'title_' | append: i
      if block.settings[icon_key] != blank or block.settings[title_key] != blank
        assign has_items = true
        break
      endif
    endfor
  %}

  {% if has_items %}
    <div class="ai-benefits-marquee__track-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign title_key = 'title_' | append: i
          assign link_key = 'link_' | append: i
          assign new_tab_key = 'open_in_new_tab_' | append: i

          assign icon = block.settings[icon_key]
          assign title = block.settings[title_key]
          assign link = block.settings[link_key]
          assign new_tab = block.settings[new_tab_key]
        %}

        {% if icon != blank or title != blank %}
          <div class="ai-benefits-marquee__item-{{ ai_gen_id }}">
            {% if link != blank %}
              <a
                href="{{ link }}"
                class="ai-benefits-marquee__item-link-{{ ai_gen_id }}"
                {% if new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <div class="ai-benefits-marquee__icon-{{ ai_gen_id }}">
                  {% if icon != blank %}
                    <img
                      src="{{ icon | image_url: width: 200 }}"
                      alt="{{ title | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    <div class="ai-benefits-marquee__icon-placeholder-{{ ai_gen_id }}"></div>
                  {% endif %}
                </div>
                {% if title != blank %}
                  <h3 class="ai-benefits-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
                {% endif %}
              </a>
            {% else %}
              <div class="ai-benefits-marquee__icon-{{ ai_gen_id }}">
                {% if icon != blank %}
                  <img
                    src="{{ icon | image_url: width: 200 }}"
                    alt="{{ title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-benefits-marquee__icon-placeholder-{{ ai_gen_id }}"></div>
                {% endif %}
              </div>
              {% if title != blank %}
                <h3 class="ai-benefits-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% for i in (1..8) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign title_key = 'title_' | append: i
          assign link_key = 'link_' | append: i
          assign new_tab_key = 'open_in_new_tab_' | append: i

          assign icon = block.settings[icon_key]
          assign title = block.settings[title_key]
          assign link = block.settings[link_key]
          assign new_tab = block.settings[new_tab_key]
        %}

        {% if icon != blank or title != blank %}
          <div class="ai-benefits-marquee__item-{{ ai_gen_id }}" aria-hidden="true">
            {% if link != blank %}
              <a
                href="{{ link }}"
                class="ai-benefits-marquee__item-link-{{ ai_gen_id }}"
                {% if new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                tabindex="-1"
              >
                <div class="ai-benefits-marquee__icon-{{ ai_gen_id }}">
                  {% if icon != blank %}
                    <img
                      src="{{ icon | image_url: width: 200 }}"
                      alt="{{ title | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {% else %}
                    <div class="ai-benefits-marquee__icon-placeholder-{{ ai_gen_id }}"></div>
                  {% endif %}
                </div>
                {% if title != blank %}
                  <h3 class="ai-benefits-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
                {% endif %}
              </a>
            {% else %}
              <div class="ai-benefits-marquee__icon-{{ ai_gen_id }}">
                {% if icon != blank %}
                  <img
                    src="{{ icon | image_url: width: 200 }}"
                    alt="{{ title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-benefits-marquee__icon-placeholder-{{ ai_gen_id }}"></div>
                {% endif %}
              </div>
              {% if title != blank %}
                <h3 class="ai-benefits-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-benefits-marquee__empty-state-{{ ai_gen_id }}">
      Add benefit items to create your marquee
    </div>
  {% endif %}
</benefits-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class BenefitsMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustAnimationSpeed();
      }

      adjustAnimationSpeed() {
        const track = this.querySelector('.ai-benefits-marquee__track-{{ ai_gen_id }}');
        if (!track) return;

        const trackWidth = track.scrollWidth / 2;
        const speed = {{ block.settings.animation_speed }};
        const pixelsPerSecond = trackWidth / speed;

        track.style.setProperty('--marquee-speed', `${speed}s`);
      }
    }

    customElements.define('benefits-marquee-{{ ai_gen_id }}', BenefitsMarquee{{ ai_gen_id }});
  })();
</script>

