{% doc %}
  @prompt
    Add ticker with multiple texts and icon images, add 10 text and also make mobile responsive
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .ai-ticker-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: 16px 0;
    position: relative;
  }

  .ai-ticker-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-ticker-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    align-items: center;
  }

  .ai-ticker-{{ ai_gen_id }}:hover .ai-ticker-wrapper-{{ ai_gen_id }} {
    animation-play-state: {% if block.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  .ai-ticker-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 24px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-ticker-icon-{{ ai_gen_id }} {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent !important;
  }

  .ai-ticker-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1) !important;
    -webkit-filter: brightness(0) invert(1) !important;
  }

  .ai-ticker-text-{{ ai_gen_id }} {
    color: #ffffff !important;
    font-size: 26px !important;
    font-weight: 400 !important;
    font-family: 'Anton', 'Impact', sans-serif !important;
    text-transform: uppercase !important;
    letter-spacing: 1.5px !important;
    line-height: 1 !important;
  }

  @keyframes ai-ticker-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ticker-{{ ai_gen_id }} {
      padding: 12px 0;
    }

    .ai-ticker-icon-{{ ai_gen_id }} {
      width: 22px;
      height: 22px;
    }

    .ai-ticker-text-{{ ai_gen_id }} {
      font-size: 18px !important;
    }

    .ai-ticker-item-{{ ai_gen_id }} {
      gap: 8px;
      padding: 0 16px;
    }
  }
{% endstyle %}

<ticker-component-{{ ai_gen_id }} class="ai-ticker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ticker-wrapper-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% for j in (1..10) %}
        {% liquid
          assign text_key = 'text_' | append: j
          assign icon_key = 'icon_' | append: j
          assign text_value = block.settings[text_key]
          assign icon_value = block.settings[icon_key]
        %}
        
        {% if text_value != blank %}
          <div class="ai-ticker-item-{{ ai_gen_id }}">
            <div class="ai-ticker-icon-{{ ai_gen_id }}">
              {% assign text_upper = text_value | upcase %}
              {% if text_upper contains 'MAIDA' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              {% elsif text_upper contains 'PALM' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
              {% elsif text_upper contains 'SUGAR' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              {% elsif text_upper contains 'PRESERVATIVE' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% elsif text_upper contains 'FLAVOR' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z"/></svg>
              {% elsif text_upper contains 'COLOR' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4" fill="#700a0c"/></svg>
              {% elsif text_upper contains 'NATURAL' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><path d="M17 8C8 10 59 16.17 3.83 12 2c-1.83 1.83-2 4.83.17 6.83 2.17 2.17 5.17 2 6.83.17C14.17 14 17 8 17 8z"/></svg>
              {% else %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              {% endif %}
            </div>
            <span class="ai-ticker-text-{{ ai_gen_id }}">{{ text_value }}</span>
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</ticker-component-{{ ai_gen_id }}>

<script>
  (function() {
    class TickerComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustAnimation();
      }

      adjustAnimation() {
        const wrapper = this.querySelector('.ai-ticker-wrapper-{{ ai_gen_id }}');
        if (!wrapper) return;

        const firstItem = wrapper.querySelector('.ai-ticker-item-{{ ai_gen_id }}');
        if (!firstItem) return;

        const itemCount = wrapper.querySelectorAll('.ai-ticker-item-{{ ai_gen_id }}').length / 2;
        
        if (itemCount === 0) return;
      }
    }

    customElements.define('ticker-component-{{ ai_gen_id }}', TickerComponent{{ ai_gen_id }});
  })();
</script>

