{% doc %}
  @prompt
    Exact clone of the product listing section with pill tabs (SINGLE, SHAREBOX, COMBO), clean white product cards with light border/shadow, flame BESTSELLER badges, quick view pill buttons, bold uppercase product titles, pack subtitles, pricing with discount badges, red ADD TO CART buttons with cart icon, and wishlist heart buttons.
  @updated 2026-07-27
{% enddoc %}
{% comment %} Live product listing section block {% endcomment %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .ai-product-slider-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
    padding: 20px 20px;
  }

  /* Centered Filter Tabs Bar */
  .ai-product-tabs-container-{{ ai_gen_id }} {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 14px !important;
    margin-bottom: 32px !important;
    width: 100% !important;
    flex-wrap: wrap !important;
  }

  .ai-product-tab-btn-{{ ai_gen_id }} {
    background-color: #ffffff !important;
    background: #ffffff !important;
    border: 1px solid #e0e0e0 !important;
    border-radius: 10px !important;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: 15px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    color: #111111 !important;
    cursor: pointer !important;
    padding: 10px 36px !important;
    transition: all 0.2s ease !important;
    letter-spacing: 0.5px !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04) !important;
  }

  .ai-product-tab-btn-{{ ai_gen_id }}:hover {
    border-color: #d32f2f !important;
    color: #d32f2f !important;
  }

  .ai-product-tab-btn-{{ ai_gen_id }}.active {
    background-color: #d32f2f !important;
    background: #d32f2f !important;
    color: #ffffff !important;
    border-color: #d32f2f !important;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.3) !important;
  }

  .ai-product-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    cursor: grab;
    user-select: none;
    transition: transform 0.3s ease;
    padding: 10px 0;
  }

  .ai-product-slider-track-{{ ai_gen_id }}.dragging {
    cursor: grabbing;
    transition: none;
  }

  /* Product Card Container - 4 per row desktop */
  .ai-product-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - (3 * {{ block.settings.card_gap }}px)) / 4) !important;
    max-width: 330px !important;
    min-height: 520px !important;
    height: auto !important;
    background-color: #ffffff !important;
    border-radius: 16px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important;
    border: 1px solid #eaeaea !important;
    overflow: visible !important;
    position: relative;
    padding: 14px !important;
    margin-bottom: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.09) !important;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.3s ease !important;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card-image-wrapper-{{ ai_gen_id }} img {
    transform: scale(1.04) !important;
  }

  /* Flame BESTSELLER badge */
  .ai-product-badge-bestseller-{{ ai_gen_id }} {
    position: absolute !important;
    top: 10px !important;
    left: 10px !important;
    background-color: #d32f2f !important;
    color: #ffffff !important;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    padding: 4px 9px !important;
    border-radius: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    z-index: 2 !important;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12) !important;
  }

  /* Pack Sub-badge (Top Right) */
  .ai-product-badge-pack-{{ ai_gen_id }} {
    position: absolute !important;
    top: 10px !important;
    right: 10px !important;
    background-color: #4c2174 !important;
    color: #ffffff !important;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    padding: 4px 8px !important;
    border-radius: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    z-index: 2 !important;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12) !important;
  }

  /* Quick View Button */
  .ai-product-quick-view-btn-{{ ai_gen_id }} {
    position: absolute !important;
    bottom: 10px !important;
    right: 10px !important;
    z-index: 10 !important;
    background: rgba(255, 255, 255, 0.95) !important;
    color: #111111 !important;
    border-radius: 20px !important;
    padding: 5px 12px !important;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    border: 1px solid #e0e0e0 !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08) !important;
    transition: all 0.2s ease !important;
  }

  .ai-product-quick-view-btn-{{ ai_gen_id }}:hover {
    background: #ffffff !important;
    transform: scale(1.04) !important;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: 16px 0 10px !important;
    text-align: left !important;
    flex-grow: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: flex-start !important;
    width: 100% !important;
    min-height: 180px !important;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: {{ block.settings.title_font_size }}px !important;
    font-weight: 800 !important;
    color: {{ block.settings.title_color }} !important;
    margin: 0 0 6px 0 !important;
    line-height: 1.35 !important;
    min-height: 38px !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    text-transform: uppercase !important;
    letter-spacing: 0.2px !important;
    text-align: left !important;
    width: 100% !important;
  }

  .ai-product-card-title-{{ ai_gen_id }} a {
    color: {{ block.settings.title_color }} !important;
    text-decoration: none !important;
  }

  .ai-product-card-specs-{{ ai_gen_id }} {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #777777 !important;
    margin: 0 0 10px 0 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.3px !important;
    text-align: left !important;
    width: 100% !important;
  }

  /* Pricing Row */
  .ai-product-card-price-row-{{ ai_gen_id }} {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    margin-bottom: 12px !important;
  }

  .ai-product-card-price-row-{{ ai_gen_id }} .current-price {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: {{ block.settings.price_font_size }}px !important;
    font-weight: 800 !important;
    color: {{ block.settings.price_color }} !important;
  }

  .ai-product-card-price-row-{{ ai_gen_id }} .discount-badge {
    background-color: #fde8e8 !important;
    color: {{ block.settings.badge_background }} !important;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: {{ block.settings.badge_font_size }}px !important;
    font-weight: 800 !important;
    padding: 4px 8px !important;
    border-radius: 6px !important;
    text-transform: uppercase !important;
  }

  /* Action Buttons Row */
  .ai-product-card-actions-{{ ai_gen_id }} {
    display: flex !important;
    gap: 8px !important;
    width: 100% !important;
    align-items: center !important;
  }

  .ai-product-card-button-{{ ai_gen_id }} {
    flex: 1 !important;
    background-color: {{ block.settings.button_background }} !important;
    background: {{ block.settings.button_background }} !important;
    color: {{ block.settings.button_text_color }} !important;
    border-radius: 8px !important;
    padding: 10px 14px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: {{ block.settings.button_font_size }}px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    border: none !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    box-shadow: 0 2px 6px rgba(211, 47, 47, 0.2) !important;
  }

  .ai-product-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }} !important;
    background: {{ block.settings.button_hover_background }} !important;
  }

  .ai-product-wishlist-btn-{{ ai_gen_id }} {
    width: 42px !important;
    height: 42px !important;
    flex-shrink: 0 !important;
    border-radius: 8px !important;
    border: 1.5px solid #e0e0e0 !important;
    background: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
  }

  .ai-product-wishlist-btn-{{ ai_gen_id }}:hover {
    border-color: #d32f2f !important;
  }

  .ai-product-wishlist-btn-{{ ai_gen_id }}.active svg {
    fill: #d32f2f !important;
    stroke: #d32f2f !important;
  }

  .ai-product-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 30px;
  }

  .ai-product-slider-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-product-slider-dot-{{ ai_gen_id }}.active {
    background-color: #d32f2f;
    width: 24px;
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-slider-container-{{ ai_gen_id }} {
      padding: 10px 10px;
    }

    .ai-product-tabs-container-{{ ai_gen_id }} {
      gap: 8px !important;
      margin-bottom: 20px !important;
    }

    .ai-product-tab-btn-{{ ai_gen_id }} {
      font-size: 13px !important;
      padding: 8px 18px !important;
    }

    .ai-product-slider-track-{{ ai_gen_id }} {
      gap: 12px;
      padding: 5px 0;
    }

    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - 12px) / {{ block.settings.mobile_columns }}) !important;
      max-width: {{ block.settings.mobile_card_max_width }}px !important;
      padding: 10px !important;
      border-radius: 14px !important;
    }

    .ai-product-card-title-{{ ai_gen_id }} {
      font-size: 13px !important;
      min-height: 34px !important;
    }

    .ai-product-card-button-{{ ai_gen_id }} {
      font-size: 12px !important;
      padding: 8px 10px !important;
    }

    .ai-product-wishlist-btn-{{ ai_gen_id }} {
      width: 36px !important;
      height: 36px !important;
    }
  }
{% endstyle %}

<product-slider-{{ ai_gen_id }} class="ai-product-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-slider-container-{{ ai_gen_id }}">
    
    <!-- Header Filter Tabs -->
    <div class="ai-product-tabs-container-{{ ai_gen_id }}">
      <button type="button" class="ai-product-tab-btn-{{ ai_gen_id }} active" data-tab-btn="single">SINGLE</button>
      <button type="button" class="ai-product-tab-btn-{{ ai_gen_id }}" data-tab-btn="sharebox">SHAREBOX</button>
      <button type="button" class="ai-product-tab-btn-{{ ai_gen_id }}" data-tab-btn="combo">COMBO</button>
    </div>

    <!-- Product Slider Track -->
    <div class="ai-product-slider-track-{{ ai_gen_id }}" data-track>
      {% if block.settings.product_list != blank %}
        {% for product in block.settings.product_list %}
          {% assign handle_down = product.handle | downcase %}
          {% assign title_down = product.title | downcase %}
          
          {% assign product_category = "single" %}
          {% if handle_down contains 'combo' or title_down contains 'combo' or handle_down contains 'king' or handle_down contains 'variety' or handle_down contains 'pack-of-80' or handle_down contains 'x-8' or handle_down contains 'x-2' %}
            {% assign product_category = "combo" %}
          {% elsif handle_down contains 'sharebox' or title_down contains 'sharebox' or handle_down contains 'box' or handle_down contains 'wholesome' or handle_down contains 'pack-24' %}
            {% assign product_category = "sharebox" %}
          {% else %}
            {% assign product_category = "single" %}
          {% endif %}

          {% assign colors = "#F3ECE5,#F5EDE4,#EAE3EC,#F7E5E5,#EAE3EC" | split: "," %}
          {% assign color_index = forloop.index0 | modulo: 5 %}
          {% assign card_bg_color = colors[color_index] %}

          {% liquid
            assign title_u = product.title | upcase
            assign handle_u = product.handle | upcase
            assign desc_u = product.description | strip_html | upcase
            
            assign qty_text = "PACK OF 1 • 10 BARS"
            if title_u contains "MAST MIX" or handle_u contains "MAST-MIX" or title_u contains "NAMKEEN"
              assign qty_text = "PACK OF 1 • 12 NAMKEENS"
            elsif title_u contains "COMBO" or handle_u contains "COMBO"
              if title_u contains "KING" or desc_u contains "KING"
                assign qty_text = "30 BARS • 1 KING PACK"
              else
                assign qty_text = "2 PACKS • 10 BARS"
              endif
            elsif title_u contains "SHAREBOX" or handle_u contains "SHAREBOX"
              assign qty_text = "24 BARS • 1 SHAREBOX"
            elsif title_u contains "30"
              assign qty_text = "3 PACKS • 30 BARS"
            endif
          %}

          <div class="ai-product-card-{{ ai_gen_id }}" data-category="{{ product_category }}">
            <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}" style="background-color: {{ card_bg_color }};">
              <span class="ai-product-badge-bestseller-{{ ai_gen_id }}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="#ffffff">
                  <path d="M12 23c-4.97 0-9-3.58-9-8 0-4.19 3.03-7.6 7-8.77.56-.17 1.09.24 1.09.81 0 1.25.75 2.37 1.88 2.82.72.29 1.48.11 2-.43C16.59 7.71 18 5.48 18 3c0-.46.47-.78.9-.61C21.41 3.46 23 6.54 23 10c0 7.18-5.82 13-11 13z"/>
                </svg>
                BESTSELLER
              </span>

              {% if product_category == 'combo' or handle_down contains 'x-2' or handle_down contains 'bars-x' %}
                <span class="ai-product-badge-pack-{{ ai_gen_id }}">
                  PACK OF 10 BARS X 2
                </span>
              {% endif %}

              <a href="{{ product.url }}" style="display: block; width: 100%; height: 100%;">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>

              <button type="button" class="ai-product-quick-view-btn-{{ ai_gen_id }}" onclick="window.location.href='{{ product.url }}'; return false;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                Quick View
              </button>
            </div>

            <div class="ai-product-card-content-{{ ai_gen_id }}">
              <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <p class="ai-product-card-specs-{{ ai_gen_id }}">{{ qty_text }}</p>

              <div class="ai-product-card-price-row-{{ ai_gen_id }}">
                <span class="current-price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="discount-badge">
                    -{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF
                  </span>
                {% else %}
                  <span class="discount-badge">-5% OFF</span>
                {% endif %}
              </div>
            </div>

            <div class="ai-product-card-actions-{{ ai_gen_id }}">
              <button
                class="ai-product-card-button-{{ ai_gen_id }}"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                {% unless product.available %}disabled{% endunless %}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                {% if product.available %}
                  ADD TO CART
                {% else %}
                  SOLD OUT
                {% endif %}
              </button>
              <button type="button" class="ai-product-wishlist-btn-{{ ai_gen_id }}" onclick="event.preventDefault(); event.stopPropagation(); this.classList.toggle('active');">
                <svg class="wishlist-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Mock Fallback Products Matching Reference Image Exactly -->
        
        <!-- Card 1: Choco Burst Single -->
        <div class="ai-product-card-{{ ai_gen_id }}" data-category="single">
          <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}" style="background-color: #F3ECE5;">
            <span class="ai-product-badge-bestseller-{{ ai_gen_id }}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="#ffffff">
                <path d="M12 23c-4.97 0-9-3.58-9-8 0-4.19 3.03-7.6 7-8.77.56-.17 1.09.24 1.09.81 0 1.25.75 2.37 1.88 2.82.72.29 1.48.11 2-.43C16.59 7.71 18 5.48 18 3c0-.46.47-.78.9-.61C21.41 3.46 23 6.54 23 10c0 7.18-5.82 13-11 13z"/>
              </svg>
              BESTSELLER
            </span>

            <img
              src="{{ 'ChocoBurst.png' | asset_url }}"
              alt="TAAKAT HUNGER BAR | CHOCO BURST | MULTIGRAIN | CLEAN CHOCOLATE"
              loading="lazy"
              width="600"
              height="600"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >
            <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}" style="display:none; width:100%; height:100%; align-items:center; justify-content:center;">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>

            <button type="button" class="ai-product-quick-view-btn-{{ ai_gen_id }}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              Quick View
            </button>
          </div>

          <div class="ai-product-card-content-{{ ai_gen_id }}">
            <h3 class="ai-product-card-title-{{ ai_gen_id }}">
              TAAKAT HUNGER BAR | CHOCO BURST | MULTIGRAIN | CLEAN CHOCOLATE
            </h3>

            <p class="ai-product-card-specs-{{ ai_gen_id }}">PACK OF 1 • 10 BARS</p>

            <div class="ai-product-card-price-row-{{ ai_gen_id }}">
              <span class="current-price">Rs. 570.00</span>
              <span class="discount-badge">-5% OFF</span>
            </div>
          </div>

          <div class="ai-product-card-actions-{{ ai_gen_id }}">
            <button class="ai-product-card-button-{{ ai_gen_id }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              ADD TO CART
            </button>
            <button type="button" class="ai-product-wishlist-btn-{{ ai_gen_id }}" onclick="event.preventDefault(); event.stopPropagation(); this.classList.toggle('active');">
