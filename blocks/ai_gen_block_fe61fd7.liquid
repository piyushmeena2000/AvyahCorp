<script>
  (function() {
    class ProductSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.startPos = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.allCards = Array.from(this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}'));
        this.cards = this.allCards;
        this.addToCartButtons = this.querySelectorAll('.ai-product-card-button-{{ ai_gen_id }}[data-variant-id]');
        this.totalCards = this.cards.length;

        this.updateSliderSettings();
        this.initSlider();
        this.initAddToCart();
        this.initTabs();
        this.initTouchpad();

        window.addEventListener('resize', () => {
          this.updateSliderSettings();
          this.setPositionByIndex();
          this.createDots();
        });
      }

      initTouchpad() {
        this.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) {
            return;
          }
          
          e.preventDefault();
          
          if (!this.wheelTimeout) {
            if (e.deltaX > 20 && this.currentIndex < this.maxIndex) {
              this.goToSlide(this.currentIndex + 1);
            } else if (e.deltaX < -20 && this.currentIndex > 0) {
              this.goToSlide(this.currentIndex - 1);
            }
            this.wheelTimeout = setTimeout(() => {
              this.wheelTimeout = null;
            }, 300);
          }
        }, { passive: false });
      }

      updateSliderSettings() {
        this.cardsVisible = window.innerWidth > 749 ? {{ block.settings.desktop_cards_visible }} : {{ block.settings.mobile_columns }};
        this.maxIndex = Math.max(0, this.totalCards - Math.ceil(this.cardsVisible));
        this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
      }

      initAddToCart() {
        this.addToCartButtons.forEach(button => {
          button.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const variantId = button.dataset.variantId;
            const originalText = button.innerHTML;

            if (!variantId || button.disabled) return;

            button.disabled = true;
            button.textContent = 'ADDING...';

            try {
              const cartItemsComponents = document.querySelectorAll('cart-items-component');
              const cartItemComponentsSectionIds = [];
              cartItemsComponents.forEach((item) => {
                if (item instanceof HTMLElement && item.dataset.sectionId) {
                  cartItemComponentsSectionIds.push(item.dataset.sectionId);
                }
              });

              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  items: [{
                    id: variantId,
                    quantity: 1
                  }],
                  sections: cartItemComponentsSectionIds.join(',')
                })
              });

              if (!response.ok) {
                throw new Error('Failed to add to cart');
              }

              const responseData = await response.json();

              button.textContent = 'ADDED!';

              setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
              }, 2000);

              const cartEvent = new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: responseData,
                  sourceId: variantId,
                  data: {
                    source: 'product-form-component',
                    itemCount: 1,
                    productId: button.dataset.productId,
                    sections: responseData.sections,
                  }
                }
              });
              
              document.dispatchEvent(cartEvent);

              const drawerComponent = document.querySelector('cart-drawer-component');
              if (drawerComponent && typeof drawerComponent.open === 'function') {
                drawerComponent.open();
              } else {
                const dialog = document.querySelector('dialog.cart-drawer__dialog');
                if (dialog && !dialog.open && typeof dialog.showModal === 'function') {
                  dialog.showModal();
                }
              }

            } catch (error) {
              console.error('Error adding to cart:', error);
              button.textContent = 'ERROR';
              setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
              }, 2000);
            }
          });
        });
      }

      initSlider() {
        if (!this.track) return;

        this.track.addEventListener('mousedown', this.dragStart.bind(this));
        this.track.addEventListener('touchstart', this.dragStart.bind(this), { passive: true });
        this.track.addEventListener('mouseup', this.dragEnd.bind(this));
        this.track.addEventListener('touchend', this.dragEnd.bind(this));
        this.track.addEventListener('mousemove', this.drag.bind(this));
        this.track.addEventListener('touchmove', this.drag.bind(this), { passive: false });
        this.track.addEventListener('mouseleave', this.dragEnd.bind(this));

        this.createDots();
        this.setPositionByIndex();
      }

      initTabs() {
        const tabs = this.querySelectorAll('[data-tab-btn]');
        tabs.forEach(tab => {
          tab.addEventListener('click', (e) => {
            e.preventDefault();
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            
            const category = tab.dataset.tabBtn;
            this.filterCategory(category);
          });
        });

        const activeTab = this.querySelector('[data-tab-btn].active');
        const initialCategory = activeTab ? activeTab.dataset.tabBtn : 'single';
        this.filterCategory(initialCategory);
      }

      filterCategory(category) {
        let visibleCount = 0;
        this.allCards.forEach(card => {
          const cardCat = card.dataset.category || 'single';
          if (category === 'all' || cardCat === category) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          this.allCards.forEach(card => {
            card.style.display = 'flex';
          });
        }

        this.cards = this.allCards.filter(card => card.style.display !== 'none');
        this.totalCards = this.cards.length;
        this.currentIndex = 0;

        if (this.track) {
          this.track.style.transition = 'none';
          this.currentTranslate = 0;
          this.prevTranslate = 0;
          this.track.style.transform = `translateX(0px)`;
          setTimeout(() => {
            this.track.style.transition = 'transform 0.3s ease';
          }, 50);
        }

        this.updateSliderSettings();
        this.setPositionByIndex();
        this.createDots();
      }

      createDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;

        if (dotsCount <= 1) {
          this.dotsContainer.style.display = 'none';
          return;
        } else {
          this.dotsContainer.style.display = 'flex';
        }

        for (let i = 0; i < dotsCount; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-product-slider-dot-{{ ai_gen_id }}');
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;
        const dots = this.dotsContainer.querySelectorAll('.ai-product-slider-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      goToSlide(index) {
        this.currentIndex = Math.max(0, Math.min(index, this.maxIndex));
        this.setPositionByIndex();
        this.updateDots();
      }

      dragStart(event) {
        if (event.target.closest('.ai-product-card-button-{{ ai_gen_id }}') || event.target.closest('.ai-product-wishlist-btn-{{ ai_gen_id }}') || event.target.closest('.ai-product-quick-view-btn-{{ ai_gen_id }}')) {
          return;
        }

        this.isDragging = true;
        this.startPos = this.getPositionX(event);
        this.track.classList.add('dragging');
      }

      drag(event) {
        if (!this.isDragging) return;
        
        if (event.type.includes('touch')) {
          event.preventDefault();
        }
        
        const currentPosition = this.getPositionX(event);
        this.currentTranslate = this.prevTranslate + currentPosition - this.startPos;
        this.track.style.transform = `translateX(${this.currentTranslate}px)`;
      }

      dragEnd() {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.track.classList.remove('dragging');

        const movedBy = this.currentTranslate - this.prevTranslate;
        const cardWidth = this.cards[0] ? this.cards[0].offsetWidth : (this.track.offsetWidth / this.cardsVisible);

        if (movedBy < -cardWidth / 5 && this.currentIndex < this.maxIndex) {
          this.currentIndex += 1;
        } else if (movedBy > cardWidth / 5 && this.currentIndex > 0) {
          this.currentIndex -= 1;
        }

        this.setPositionByIndex();
        this.updateDots();
      }

      getPositionX(event) {
        return event.type.includes('mouse') ? event.pageX : event.touches[0].clientX;
      }

      setPositionByIndex() {
        if (!this.track) return;
        const cardWidth = this.cards[0] ? this.cards[0].offsetWidth : (this.track.offsetWidth / this.cardsVisible);
        const gap = window.innerWidth > 749 ? {{ block.settings.card_gap }} : 12;
        this.currentTranslate = -(this.currentIndex * (cardWidth + gap));
        this.prevTranslate = this.currentTranslate;
        this.track.style.transform = `translateX(${this.currentTranslate}px)`;
      }
    }

    customElements.define('product-slider-{{ ai_gen_id }}', ProductSlider{{ ai_gen_id }});
  })();
</script>

